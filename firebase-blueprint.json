{
  "entities": {
    "Gig": {
      "title": "Gig",
      "description": "Job gig posting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "creatorId", "title", "lat", "lng"]
    },
    "GigApplication": {
      "title": "Gig Application",
      "description": "User application to a gig",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "seekerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "appliedAt": { "type": "string" }
      },
      "required": ["id", "seekerId", "status", "appliedAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and verification submission",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "name": { "type": "string", "maxLength": 100 },
        "middleName": { "type": "string", "maxLength": 100 },
        "surname": { "type": "string", "maxLength": 100 },
        "dob": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "location": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "contactNumber": { "type": "string", "maxLength": 50 },
        "bio": { "type": "string", "maxLength": 1000 },
        "profilePhoto": { "type": "string", "maxLength": 500000 },
        "verificationStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "monthlyProfit": { "type": "number" },
        "isTenant": { "type": "boolean" },
        "tenantStatus": { "type": "string", "enum": ["active", "inactive"] },
        "role": { "type": "string", "enum": ["user", "admin", "seeker", "creator"] },
        "idDocuments": {
          "type": "array",
          "items": { "type": "string" },
          "maxLength": 5
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "AgreementForm": {
      "title": "Agreement Form",
      "description": "User agreement document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["signed", "unsigned"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "uid", "title"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 }
      },
      "required": ["uid", "email"]
    },
    "UserActivity": {
      "title": "User Activity",
      "description": "Log of user actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "type", "description", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": {
        "$ref": "#/entities/UserActivity"
      },
      "description": "User activity logs"
    },
    "/users/{userId}/agreements/{agreementId}": {
      "schema": {
        "$ref": "#/entities/AgreementForm"
      },
      "description": "User agreement forms"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Admin records"
    },
    "/gigs/{gigId}": {
      "schema": {
        "$ref": "#/entities/Gig"
      },
      "description": "Gig postings"
    },
    "/gigs/{gigId}/applications/{applicationId}": {
      "schema": {
        "$ref": "#/entities/GigApplication"
      },
      "description": "Gig applications"
    }
  }
}
