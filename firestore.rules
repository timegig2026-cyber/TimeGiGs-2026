rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Decoupled security logic using a system-defined admins collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTenantUser() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTenant == true)
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        userId == request.auth.uid || 
        isAdmin() || 
        isTenantUser() || 
        (resource.data.role == 'seeker' && resource.data.verificationStatus == 'approved')
      );
      
      // Fixed list rule for seeker discovery
      allow list: if isSignedIn() && (
        isAdmin() || 
        isTenantUser() || 
        (resource.data.role == 'seeker' && resource.data.verificationStatus == 'approved')
      );

      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && (
        !request.resource.data.keys().hasAny(['isAdmin', 'verificationStatus', 'isTenant']) ||
        request.resource.data.verificationStatus == 'none'
      );

      allow update: if isSignedIn() && isValidId(userId) && (
        (userId == request.auth.uid && request.resource.data.uid == resource.data.uid && (
          // Normal users cannot verify themselves or change their tenant status directly
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'middleName', 'surname', 'dob', 'address', 'location', 'province', 'contactNumber', 'bio', 'profilePhoto', 'idDocuments', 'socialLinks', 'skills', 'submittedAt', 'verificationStatus', 'role']) &&
          (resource.data.verificationStatus != 'approved' || request.resource.data.verificationStatus == 'approved') &&
          (request.resource.data.verificationStatus == 'pending' || request.resource.data.verificationStatus == resource.data.verificationStatus)
        )) ||
        isAdmin()
      );

      allow delete: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
    }

    match /users/{userId}/activities/{activityId} {
      allow read: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isTenantUser() || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId}/agreements/{agreementId} {
      allow read, write: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
