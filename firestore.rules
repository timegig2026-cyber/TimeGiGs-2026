rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Admin check with bootstrapping for the owner
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'timegig2026@gmail.com')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Helpers
    function isValidUser(data) {
      // Type safety and boundary checks (called on create and update)
      return (data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
             (data.email == null || (data.email is string && data.email.size() <= 256)) &&
             (data.role == null || data.role in ['user', 'admin', 'seeker', 'creator']) &&
             (data.verificationStatus == null || data.verificationStatus in ['none', 'pending', 'approved', 'rejected']) &&
             (data.tenantStatus == null || data.tenantStatus in ['active', 'inactive']) &&
             (data.name == null || (data.name is string && data.name.size() <= 100)) &&
             (data.bio == null || (data.bio is string && data.bio.size() <= 1000));
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['id', 'type', 'description', 'timestamp']) &&
             data.keys().hasOnly(['id', 'type', 'description', 'timestamp', 'metadata']) &&
             data.id is string && data.id.size() <= 128 &&
             data.type is string && data.type.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.timestamp is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      
      allow list: if isSignedIn() && (
        isAdmin() || 
        (existing().role == 'seeker' && existing().verificationStatus == 'approved') ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTenant == true)
      );

      allow create: if isOwner(userId) && isValidId(userId) && 
                       incoming().keys().hasAll(['uid', 'email', 'role']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'name', 'middleName', 'surname', 'dob', 'address', 'location', 'province', 'contactNumber', 'bio', 'profilePhoto', 'verificationStatus', 'monthlyProfit', 'isTenant', 'tenantStatus', 'role', 'idDocuments', 'socialLinks', 'skills', 'createdAt', 'submittedAt']) &&
                       isValidUser(incoming()) && (
        // Prevent users from setting elevated privileges on creation
        !incoming().keys().hasAny(['isAdmin']) &&
        incoming().verificationStatus == 'none' &&
        incoming().role != 'admin'
      );

      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUser(incoming()) && (
          // Users cannot change their own UID or email
          (!incoming().keys().hasAny(['uid']) || incoming().uid == existing().uid) &&
          (!incoming().keys().hasAny(['email']) || incoming().email == existing().email) &&
          
          // Action: User Profile Update
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'middleName', 'surname', 'dob', 'address', 'location', 'province', 'contactNumber', 'bio', 'profilePhoto', 'idDocuments', 'socialLinks', 'skills', 'submittedAt', 'isTenant', 'tenantStatus', 'monthlyProfit', 'role', 'verificationStatus']) && (
            // Role can only be changed between user/seeker/creator, never to admin
            (!incoming().keys().hasAny(['role']) || incoming().role in ['user', 'seeker', 'creator']) &&
            // Verification status can only be set to 'pending' by user, or stay same
            (!incoming().keys().hasAny(['verificationStatus']) || incoming().verificationStatus == 'pending' || incoming().verificationStatus == existing().verificationStatus)
          ))
        )) ||
        isAdmin()
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidActivity(incoming());
      }

      match /agreements/{agreementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /gigs/{gigId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator' && 
                       isValidId(gigId) &&
                       incoming().keys().hasAll(['id', 'creatorId', 'title', 'lat', 'lng']) &&
                       incoming().keys().hasOnly(['id', 'creatorId', 'title', 'description', 'price', 'lat', 'lng', 'createdAt']) &&
                       incoming().creatorId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
      
      match /applications/{applicationId} {
         allow read: if isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/gigs/$(gigId)).data.creatorId || request.auth.uid == resource.data.seekerId);
         allow create: if isSignedIn() && isValidId(applicationId) && request.auth.uid == incoming().seekerId;
      }
    }

    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
