rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'timegig2026@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isTenantUser() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTenant == true)
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin() || isTenantUser());
      allow list: if isSignedIn() && (isAdmin() || isTenantUser());
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && (
        !incoming().keys().hasAny(['isAdmin', 'verificationStatus', 'isTenant']) ||
        incoming().verificationStatus == 'none'
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        (userId == request.auth.uid && incoming().uid == existing().uid && (
          // Normal users cannot verify themselves or change their tenant status directly
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'middleName', 'surname', 'dob', 'address', 'location', 'province', 'contactNumber', 'bio', 'profilePhoto', 'idDocuments', 'socialLinks', 'skills', 'submittedAt', 'verificationStatus']) &&
          (existing().verificationStatus != 'approved' || incoming().verificationStatus == 'approved') &&
          (incoming().verificationStatus == 'pending' || incoming().verificationStatus == existing().verificationStatus)
        )) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
    }

    match /users/{userId}/activities/{activityId} {
      allow read: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isTenantUser());
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId}/agreements/{agreementId} {
      allow read, write: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
